# =============================================================================
# eda-tools.def  -  Apptainer definition for an open-source EDA tutorial image
#
# Base:  Ubuntu 26.04 LTS (latest Ubuntu release)
# Tools (built from source on GitHub):
#   verilator  v5.054   https://github.com/verilator/verilator
#   yosys      v0.70    https://github.com/YosysHQ/yosys
#   OpenSTA    master   https://github.com/parallaxsw/OpenSTA        (no tags)
#   OpenROAD   26Q4     https://github.com/The-OpenROAD-Project/OpenROAD
#   xschem     3.4.7    https://github.com/StefanSchippers/xschem
#   magic      8.3.695  https://github.com/rtimothyedwards/magic
#   netgen     1.5.327  https://github.com/rtimothyedwards/netgen
#
# Build (needs root or fakeroot):
#   sudo apptainer build eda-tools.sif eda-tools.def
#   # or: apptainer build --fakeroot eda-tools.sif eda-tools.def
#
# Resources: OpenROAD is by far the heaviest part. Plan for ~16 GB RAM,
# ~50 GB free disk (set APPTAINER_TMPDIR to a large disk) and 1-3 hours
# depending on core count.
#
# To bump a version, change the *_REF variable below. List a repo's tags with:
#   git ls-remote --tags --refs https://github.com/<owner>/<repo>.git
# =============================================================================

Bootstrap: docker
From: ubuntu:26.04

%labels
    Description  Open-source digital/analog EDA tools for teaching
    Verilator    v5.054
    Yosys        v0.70
    OpenSTA      master
    OpenROAD     26Q4
    Xschem       3.4.7
    Magic        8.3.695
    Netgen       1.5.327

%help
    Open-source EDA tools: verilator, yosys, sta (OpenSTA), openroad,
    xschem, magic, netgen.

    Usage:
      apptainer run   eda-tools.sif              # interactive shell
      apptainer exec  eda-tools.sif yosys        # run one tool
      apptainer exec  eda-tools.sif magic        # GUI tools open on your desktop
      apptainer exec  --nv eda-tools.sif openroad -gui   # NVIDIA GPU hosts

    Your home directory is available inside the container as usual.

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # ---- Versions (latest tags at the time of writing; master if no tags) ----
    VERILATOR_REF=v5.054
    YOSYS_REF=v0.70
    OPENSTA_REF=master
    CUDD_REF=cudd-3.0.0          # required by OpenSTA
    OPENROAD_REF=26Q4
    XSCHEM_REF=3.4.7
    MAGIC_REF=8.3.695
    NETGEN_REF=1.5.327

    PREFIX=/usr/local
    JOBS=$(nproc)
    SRC=/tmp/eda-src
    mkdir -p "$SRC"

    # Shallow clone of one tag/branch, with submodules
    fetch() {  # fetch <url> <ref> <dir>
        git clone --depth 1 --branch "$2" --recurse-submodules \
            "$1" "$SRC/$3"
    }

    # ---- System packages ----------------------------------------------------
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential git ca-certificates curl wget \
        autoconf automake libtool m4 pkg-config cmake \
        python3 python3-dev perl help2man gawk \
        flex bison libfl-dev libfl2 \
        zlib1g-dev liblz4-dev libreadline-dev libffi-dev libncurses-dev \
        tcl-dev tk-dev tcl-tclreadline swig libeigen3-dev \
        libx11-dev libx11-xcb-dev libxpm-dev libxrender-dev libxcb1-dev \
        libcairo2-dev libglu1-mesa-dev mesa-common-dev \
        libgl1-mesa-dri fonts-dejavu-core \
        graphviz xdot

    # ---- Verilator ----------------------------------------------------------
    fetch https://github.com/verilator/verilator.git "$VERILATOR_REF" verilator
    cd "$SRC/verilator"
    autoconf
    ./configure --prefix="$PREFIX"
    make -j"$JOBS"
    make install

    # ---- Yosys (CMake build) ------------------------------------------------
    fetch https://github.com/YosysHQ/yosys.git "$YOSYS_REF" yosys
    cd "$SRC/yosys"
    cmake -B build . -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$PREFIX"
    cmake --build build --config Release --parallel "$JOBS"
    cmake --install build --strip

    # ---- CUDD (dependency of OpenSTA) ---------------------------------------
    fetch https://github.com/cuddorg/cudd.git "$CUDD_REF" cudd
    cd "$SRC/cudd"
    autoreconf -fi
    ./configure --prefix="$PREFIX"
    make -j"$JOBS"
    make install

    # ---- OpenSTA (standalone 'sta' binary) ----------------------------------
    fetch https://github.com/parallaxsw/OpenSTA.git "$OPENSTA_REF" OpenSTA
    cd "$SRC/OpenSTA"
    cmake -B build . -DCMAKE_BUILD_TYPE=Release \
        -DCUDD_DIR="$PREFIX" -DCMAKE_INSTALL_PREFIX="$PREFIX"
    cmake --build build --parallel "$JOBS"
    cmake --install build

    # ---- OpenROAD (Bazel is its supported build system) ---------------------
    fetch https://github.com/The-OpenROAD-Project/OpenROAD.git "$OPENROAD_REF" OpenROAD
    cd "$SRC/OpenROAD"
    # Installs bazelisk + the runtime libraries needed for the Qt GUI
    ./etc/DependencyInstaller.sh -bazel
    export OPENROAD_VERSION="$OPENROAD_REF"
    BAZEL_ROOT=/tmp/bazel-root
    bazelisk --output_user_root="$BAZEL_ROOT" run --stamp \
        --//:platform=gui //:install -- "$PREFIX"
    bazelisk --output_user_root="$BAZEL_ROOT" shutdown || true
    rm -rf "$BAZEL_ROOT" /root/.cache/bazelisk /root/.cache/bazel

    # ---- xschem -------------------------------------------------------------
    fetch https://github.com/StefanSchippers/xschem.git "$XSCHEM_REF" xschem
    cd "$SRC/xschem"
    ./configure --prefix="$PREFIX"
    make -j"$JOBS"
    make install

    # ---- magic --------------------------------------------------------------
    fetch https://github.com/rtimothyedwards/magic.git "$MAGIC_REF" magic
    cd "$SRC/magic"
    ./configure --prefix="$PREFIX"
    make            # magic's build is not reliably parallel
    make install

    # ---- netgen -------------------------------------------------------------
    fetch https://github.com/rtimothyedwards/netgen.git "$NETGEN_REF" netgen
    cd "$SRC/netgen"
    ./configure --prefix="$PREFIX"
    make
    make install

    # ---- Clean up -----------------------------------------------------------
    cd /
    rm -rf "$SRC"
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    ldconfig

%runscript
    if [ $# -eq 0 ]; then
        exec /bin/bash
    else
        exec "$@"
    fi

%test
    set -e
    for t in verilator yosys sta openroad xschem magic netgen; do
        command -v "$t" >/dev/null || { echo "MISSING: $t"; exit 1; }
    done
    verilator --version
    yosys -V
    openroad -version
    echo "All tools present."
